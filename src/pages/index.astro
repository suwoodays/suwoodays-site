---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate } from '../lib/posts';

const posts = getPosts().slice(0, 5);
---

<Base>
  <section class="hero">
    <h1>아이와 떠나는 장기 해외여행 노트</h1>
    <p>
      가족과 함께 세계여행을 하며 직접 겪은 준비, 비용, 시행착오를 기록합니다.
      출발 전에 알았으면 좋았을 것들을 정리해 두었어요.
    </p>
    <a class="button" href="/blog/">글 보러 가기</a>
  </section>

  <h2 style="margin-top:0">최근 글</h2>
  {
    posts.length === 0 ? (
      <p>아직 올라온 글이 없어요. 곧 채워집니다.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a class="title" href={`/blog/${post.slug}/`}>{post.meta.title}</a>
            <div class="meta">{formatDate(post.meta.date)}</div>
            {post.meta.description && <p class="desc">{post.meta.description}</p>}
          </li>
        ))}
      </ul>
    )
  }
</Base>
