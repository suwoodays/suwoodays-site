---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate } from '../lib/posts';

const all = getPosts();
const recent = all.slice(0, 3);
const hub = all.find((p) => p.slug === 'prep-checklist-before-departure');

// 주제별 묶음: 글의 tags 로 자동 분류됩니다. 새 글에 같은 태그만 달면 알아서 들어갑니다.
const topics = [
  { name: '출발 전 준비', desc: '보험, 학교, 입국 서류처럼 떠나기 전에 정리한 것들', tags: ['준비', '학교', '입국'] },
  { name: '치앙마이에서', desc: '아이와 직접 다니며 쓴 비용과 현장 기록', tags: ['치앙마이'] },
].map((t) => ({
  ...t,
  posts: all.filter((p) => p.slug !== hub?.slug && (p.meta.tags ?? []).some((tag) => t.tags.includes(tag))),
}));
---

<Base>
  <section class="hero">
    <h1>아이와 떠나는 장기 해외여행 노트</h1>
    <p>
      초등학생 두 아이와 함께 9개월 세계여행 중인 가족이 직접 겪은 준비, 비용, 시행착오를 기록합니다.
      출발 전에 알았으면 좋았을 것들을 정리해 두었어요.
    </p>
    <a class="button" href="/blog/">전체 글 보기</a>
  </section>

  {hub && (
    <a class="start-card" href={`/blog/${hub.slug}/`}>
      <span class="label">처음 오셨다면</span>
      <strong>{hub.meta.title}</strong>
      {hub.meta.description && <span class="desc">{hub.meta.description}</span>}
    </a>
  )}

  {topics.filter((t) => t.posts.length > 0).map((t) => (
    <section class="topic">
      <h2>{t.name}</h2>
      <p class="topic-desc">{t.desc}</p>
      <ul class="post-list">
        {t.posts.map((post) => (
          <li>
            <a class="title" href={`/blog/${post.slug}/`}>{post.meta.title}</a>
            <div class="meta">{formatDate(post.meta.date)}</div>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="topic">
    <h2>최근 글</h2>
    <ul class="post-list">
      {recent.map((post) => (
        <li>
          <a class="title" href={`/blog/${post.slug}/`}>{post.meta.title}</a>
          <div class="meta">{formatDate(post.meta.date)}</div>
          {post.meta.description && <p class="desc">{post.meta.description}</p>}
        </li>
      ))}
    </ul>
  </section>
</Base>
