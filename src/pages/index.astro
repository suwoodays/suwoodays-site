---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate, CATEGORIES, getPostsByCategory } from '../lib/posts';

const all = getPosts();
const hub = all.find((p) => p.slug === 'prep-checklist-before-departure');
const sections = CATEGORIES.map((c) => ({
  ...c,
  posts: getPostsByCategory(c.key).filter((p) => p.slug !== hub?.slug),
})).filter((c) => c.posts.length > 0);
const latest = all.slice(0, 5);
---

<Base>
  <section class="hero">
    <h1>아이와 떠나는 장기 해외여행 노트</h1>
    <p>
      초등학생 두 아이와 함께 9개월 세계여행 중인 가족이 직접 겪은 준비, 비용, 시행착오를 기록합니다.
      출발 전에 알았으면 좋았을 것들을 정리해 두었어요.
    </p>
    <form class="search-box" action="/blog/" method="get" role="search">
      <label class="sr-only" for="hq">글 검색</label>
      <input id="hq" name="q" type="search" placeholder="궁금한 것을 검색해 보세요 (예: 보험, eSIM, 택시)" autocomplete="off" />
      <button type="submit">검색</button>
    </form>
  </section>

  {hub && (
    <a class="start-card" href={`/blog/${hub.slug}/`}>
      <span class="label">처음 오셨다면</span>
      <strong>{hub.meta.title}</strong>
      {hub.meta.description && <span class="desc">{hub.meta.description}</span>}
    </a>
  )}

  <nav class="cat-grid" aria-label="카테고리">
    {sections.map((c) => (
      <a class="cat-card" href={`/category/${c.key}/`}>
        <span class="icon">{c.icon}</span>
        <strong>{c.name}</strong>
        <span class="count">글 {getPostsByCategory(c.key).length}편</span>
        <span class="desc">{c.desc}</span>
      </a>
    ))}
  </nav>

  <section class="topic">
    <h2>최근 글</h2>
    <ul class="post-list">
      {latest.map((post) => (
        <li>
          <a class="title" href={`/blog/${post.slug}/`}>{post.meta.title}</a>
          <div class="meta">{formatDate(post.meta.date)}</div>
        </li>
      ))}
    </ul>
  </section>

  <p class="more"><a href="/blog/">전체 글 {all.length}편 보기 →</a></p>
</Base>
